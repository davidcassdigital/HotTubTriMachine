<div class="rz-p-2 header-bar" role="banner" aria-label="Application header">
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 style="width:100%; display:flex; justify-content:space-between; align-items:center; padding:10px 12px; gap:12px;">
        <!-- left: main nav (items align left) -->
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.Left"
                     style="width:100%; display:flex; align-items:center; gap:6px;">
            <NavMenu />
        </RadzenStack>

        <!-- right: action links -->
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.Right"
                     style="display:flex; align-items:center; gap:10px;">
            <Links />
        </RadzenStack>
    </RadzenStack>
</div>