@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack 
            Orientation="Orientation.Horizontal" 
            JustifyContent="JustifyContent.Center"
            AlignItems="AlignItems.Center" 
            Gap="10"
            style="height: 100%"
        >
            <RadzenLabel Text="HOT TUB TRI MACHINE" style="font-size: xx-large"/>
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

