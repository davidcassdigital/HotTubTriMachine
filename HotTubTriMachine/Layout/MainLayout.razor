@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<RadzenLayout>
    <RadzenHeader>
        <Header />
    </RadzenHeader>
        
    <RadzenBody >
        <div class="main">
            <div class="sub-main">
                <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center">
                    @Body
                </RadzenStack>                
            </div>

            <footer>
                <Footer />
            </footer>
        </div>
    </RadzenBody>
</RadzenLayout>

