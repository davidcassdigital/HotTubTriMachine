@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<RadzenLayout>
    <RadzenHeader>
        <Header />
    </RadzenHeader>
        
    <RadzenBody style="background-color: var(--tertiary-color)">
        <div style="padding:5px; height:100%; display: flex; flex-direction: column">
            <div style="flex:1; background-color: var(--tertiary-color);">
                @Body
            </div>

            <footer>
                <Footer />
            </footer>

        </div>
        

    </RadzenBody>


</RadzenLayout>

